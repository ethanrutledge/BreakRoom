@echo off
setlocal EnableExtensions
title Break Room
cd /d "%~dp0"
set "PYEXE="
set "PYCHK=import sys,tkinter;assert sys.version_info[:2]==(3,12);print(sys.executable)"

rem ---- 1. find Python 3.12 with tkinter
for /f "usebackq delims=" %%i in (`py -3.12 -c "%PYCHK%" 2^>nul`) do set "PYEXE=%%i"
if not defined PYEXE for /f "usebackq delims=" %%i in (`python -c "%PYCHK%" 2^>nul`) do set "PYEXE=%%i"
if not defined PYEXE call :known
if defined PYEXE goto havepy

rem ---- 2. no Python: install it for this user (no admin needed)
echo.
echo  Break Room: first-time setup. Installing Python, one moment...
echo  (this only happens once)
echo.
where winget >nul 2>&1
if not errorlevel 1 (
  winget install -e --id Python.Python.3.12 --scope user --silent --accept-package-agreements --accept-source-agreements
)
call :known
if defined PYEXE goto havepy
echo  Trying the python.org installer...
set "PYSETUP=%TEMP%\python-3.12.7-setup.exe"
powershell -NoProfile -ExecutionPolicy Bypass -Command "[Net.ServicePointManager]::SecurityProtocol='Tls12'; Invoke-WebRequest -UseBasicParsing 'https://www.python.org/ftp/python/3.12.7/python-3.12.7-amd64.exe' -OutFile $env:PYSETUP"
if exist "%PYSETUP%" "%PYSETUP%" /quiet InstallAllUsers=0 PrependPath=1 Include_tcltk=1 Include_pip=1 Include_launcher=0 Include_test=0
call :known
if defined PYEXE goto havepy
echo.
echo  Could not install Python automatically (this PC may block installs).
echo  Please install Python 3.12 from https://www.python.org/downloads/
echo  (tick "Add python.exe to PATH"), then double-click this file again.
echo.
pause
exit /b 1

:havepy
rem ---- 3. needed libraries (the chess library; everything else ships with Python)
"%PYEXE%" -c "import chess" >nul 2>&1
if not errorlevel 1 goto havelibs
echo  Installing the chess library...
"%PYEXE%" -m pip --version >nul 2>&1
if errorlevel 1 "%PYEXE%" -m ensurepip --upgrade >nul 2>&1
"%PYEXE%" -m pip install --quiet --disable-pip-version-check chess >nul 2>&1
"%PYEXE%" -c "import chess" >nul 2>&1
if errorlevel 1 "%PYEXE%" -m pip install --quiet --disable-pip-version-check --user chess >nul 2>&1
"%PYEXE%" -c "import chess" >nul 2>&1
if errorlevel 1 (
  echo  Could not install the chess library - the game will try again itself when it starts.
)
:havelibs

rem ---- 4. unpack the small launcher (the game itself stays packed inside this file)
set "BR_SELF=%~f0"
set "BR_DIR=%LOCALAPPDATA%\BreakRoom"
if not exist "%BR_DIR%" mkdir "%BR_DIR%" >nul 2>&1
set "BR_RUN=%BR_DIR%\br_launch.py"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText($env:BR_SELF,[Text.Encoding]::UTF8); $n=[Environment]::NewLine; $a=$t.LastIndexOf($n+':::'+'LOADER'+$n); $b=$t.LastIndexOf($n+':::'+'PAYLOAD'+$n); if($a -lt 0 -or $b -lt $a){exit 2}; $a+=$n.Length+10; [IO.File]::WriteAllText($env:BR_RUN,$t.Substring($a,$b-$a),(New-Object Text.UTF8Encoding $false))"
if errorlevel 1 (
  echo  Could not unpack the game. Make sure this file was not edited or cut short.
  pause
  exit /b 1
)

rem ---- 5. a quick check that the packed game is whole
"%PYEXE%" "%BR_RUN%" --check "%BR_SELF%" 2>"%TEMP%\br_check.txt"
if errorlevel 1 (
  echo.
  echo  The game file did not unpack cleanly. Re-download BreakRoom.bat and try again.
  echo.
  type "%TEMP%\br_check.txt"
  echo.
  pause
  exit /b 1
)
if defined BR_NOLAUNCH exit /b 0

rem ---- 6. play (pythonw = no console window)
set "PYW=%PYEXE:python.exe=pythonw.exe%"
if exist "%PYW%" (start "" "%PYW%" "%BR_RUN%" "%BR_SELF%") else (start "" "%PYEXE%" "%BR_RUN%" "%BR_SELF%")
echo  Break Room is starting. If no window appears, open break_room_error.txt
echo  in this folder - it will say what went wrong.
exit /b 0

:known
if defined PYEXE goto havepy

rem ---- 2. no Python: install it for this user (no admin needed)
echo.
echo  Break Room: first-time setup. Installing Python, one moment...
echo  (this only happens once)
echo.
where winget >nul 2>&1
if not errorlevel 1 (
  winget install -e --id Python.Python.3.12 --scope user --silent --accept-package-agreements --accept-source-agreements
)
call :known
if defined PYEXE goto havepy
echo  Trying the python.org installer...
set "PYSETUP=%TEMP%\python-3.12.7-setup.exe"
powershell -NoProfile -ExecutionPolicy Bypass -Command "[Net.ServicePointManager]::SecurityProtocol='Tls12'; Invoke-WebRequest -UseBasicParsing 'https://www.python.org/ftp/python/3.12.7/python-3.12.7-amd64.exe' -OutFile $env:PYSETUP"
if exist "%PYSETUP%" "%PYSETUP%" /quiet InstallAllUsers=0 PrependPath=1 Include_tcltk=1 Include_pip=1 Include_launcher=0 Include_test=0
call :known
if defined PYEXE goto havepy
echo.
echo  Could not install Python automatically (this PC may block installs).
echo  Please install Python 3.12 from https://www.python.org/downloads/
echo  (tick "Add python.exe to PATH"), then double-click this file again.
echo.
pause
exit /b 1

:havepy
rem ---- 3. needed libraries (the chess library; everything else ships with Python)
"%PYEXE%" -c "import chess" >nul 2>&1
if not errorlevel 1 goto havelibs
echo  Installing the chess library...
"%PYEXE%" -m pip --version >nul 2>&1
if errorlevel 1 "%PYEXE%" -m ensurepip --upgrade >nul 2>&1
"%PYEXE%" -m pip install --quiet --disable-pip-version-check chess >nul 2>&1
"%PYEXE%" -c "import chess" >nul 2>&1
if errorlevel 1 "%PYEXE%" -m pip install --quiet --disable-pip-version-check --user chess >nul 2>&1
"%PYEXE%" -c "import chess" >nul 2>&1
if errorlevel 1 (
  echo  Could not install the chess library - the game will try again itself when it starts.
)
:havelibs

rem ---- 4. unpack the game next to this file (your save file lives here too)
set "BR_SELF=%~f0"
set "BR_OUT=%~dp0break_room.py"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText($env:BR_SELF,[Text.Encoding]::UTF8); $m=[Environment]::NewLine+':::'+'PAYLOAD'+[Environment]::NewLine; $i=$t.LastIndexOf($m); if($i -lt 0){exit 2}; [IO.File]::WriteAllText($env:BR_OUT,$t.Substring($i+$m.Length),(New-Object Text.UTF8Encoding $false))"
if errorlevel 1 (
  echo  Could not unpack the game. Make sure this file was not edited or cut short.
  pause
  exit /b 1
)

rem ---- 5. a quick check that the unpacked file is whole
del /q "%~dp0break_room_error.txt" >nul 2>&1
"%PYEXE%" -c "import py_compile,sys; py_compile.compile(sys.argv[1], doraise=True)" "%BR_OUT%" 2>"%TEMP%\br_compile.txt"
if errorlevel 1 (
  echo.
  echo  The game file did not unpack cleanly. Re-download BreakRoom.bat and try again.
  echo.
  type "%TEMP%\br_compile.txt"
  echo.
  pause
  exit /b 1
)
if defined BR_NOLAUNCH exit /b 0

rem ---- 6. play (pythonw = no console window)
set "PYW=%PYEXE:python.exe=pythonw.exe%"
if exist "%PYW%" (start "" "%PYW%" "%BR_OUT%") else (start "" "%PYEXE%" "%BR_OUT%")
echo  Break Room is starting. If no window appears, open break_room_error.txt
echo  in this folder - it will say what went wrong.
exit /b 0

:known
rem the usual per-user / all-users install folders (a fresh install is not on PATH until a new window)
for %%d in ("%LOCALAPPDATA%\Programs\Python\Python312" "%ProgramFiles%\Python312") do (
  if not defined PYEXE if exist "%%~d\python.exe" "%%~d\python.exe" -c "%PYCHK%" >nul 2>&1 && set "PYEXE=%%~d\python.exe"
)
exit /b 0
:::LOADER
import base64, marshal, os, sys, types, zlib
WANT = (3, 12)
bat = os.path.abspath(sys.argv[-1])
if sys.version_info[:2] != WANT:
    sys.exit("Break Room needs Python %d.%d, this is %s" % (WANT + (sys.version.split()[0],)))
text = open(bat, encoding="utf-8").read().replace("\r\n", "\n")
code = marshal.loads(zlib.decompress(base64.b64decode("".join(text[text.rindex("\n" + ":::PAYLOAD\n") + 12:].split()))))
if "--check" in sys.argv:
    sys.exit(0)
game = types.ModuleType("__main__")
game.__file__ = os.path.join(os.path.dirname(bat), "break_room.py")   # saves and error log go next to the .bat
game.__builtins__ = __builtins__
sys.modules["__main__"] = game
sys.argv = [game.__file__]
del text, bat
exec(code, game.__dict__)
